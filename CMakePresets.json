{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-simulator",
      "displayName": "Host SDL simulator",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/host-simulator",
      "cacheVariables": {
        "LilyGoUI_DIR": "${sourceDir}/third_party/cm0-appkit",
        "CM0_LVGL_SOURCE_DIR": "",
        "CM0_FETCH_LVGL": "OFF",
        "CM0_SIMULATOR": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "host-gles-test",
      "displayName": "Offscreen host GLES validation",
      "inherits": "host-simulator",
      "binaryDir": "${sourceDir}/build/host-gles-test",
      "cacheVariables": {
        "LILYGO_NES_GLES": "ON",
        "LILYGO_NES_GLES_TEST": "ON"
      }
    },
    {
      "name": "cm0-cross",
      "displayName": "CM0 Raspberry Pi OS AArch64",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/cm0-cross",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/cm0-bsp-toolchain.cmake",
        "LilyGoUI_DIR": "${sourceDir}/third_party/cm0-appkit",
        "CM0_LVGL_SOURCE_DIR": "",
        "CM0_FETCH_LVGL": "OFF",
        "CM0_SIMULATOR": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "CMAKE_INSTALL_PREFIX": "/usr"
      }
    },
    {
      "name": "cm0-cross-gles",
      "displayName": "CM0 Raspberry Pi OS AArch64 GLES",
      "inherits": "cm0-cross",
      "binaryDir": "${sourceDir}/build/cm0-cross-gles",
      "cacheVariables": {
        "LILYGO_NES_GLES": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-simulator",
      "configurePreset": "host-simulator"
    },
    {
      "name": "cm0-cross",
      "configurePreset": "cm0-cross"
    },
    {
      "name": "cm0-cross-gles",
      "configurePreset": "cm0-cross-gles"
    },
    {
      "name": "host-gles-test",
      "configurePreset": "host-gles-test"
    }
  ],
  "testPresets": [
    {
      "name": "host-simulator",
      "configurePreset": "host-simulator",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-gles-test",
      "configurePreset": "host-gles-test",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
